    <!-- First welcome -->
    <string name="welcome_title">One screen, one fire</string>
    <string name="welcome_sub">Campfire is fifteen minutes of talk for two — a parent and a child, two friends, any two people. It works only when you are together.</string>
    <string name="how1_title">Light it together</string>
    <string name="how1_sub">Hold your stones at the same time. The fire never starts for one pair of hands.</string>
    <string name="how2_title">Ask the fire</string>
    <string name="how2_sub">Tap the fire and a spark brings a question — playful while it flares, closer when it burns down, quiet in the embers.</string>
    <string name="how3_title">One word in the ash</string>
    <string name="how3_sub">Before covering the fire, write one word for the day into the ash. Every evening stays in the box.</string>
